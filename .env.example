# Copy to .env.local for local dev, or set these in your hosting platform's
# environment config for deployment. Never commit real values.
# See README.md "Deploying to AWS" for how each value is obtained.

# Shared-password gate for the whole app (proxy.ts). Single internal
# editor, not a multi-user auth system.
EDITOR_APP_USERNAME=
EDITOR_APP_PASSWORD=

# Where rendered video ends up. "local" (default if unset) renders on this
# server with a headless-Chrome pipeline and saves to out/ - use this while
# testing before AWS Lambda is deployed. "lambda" renders on AWS Lambda and
# saves to S3 - set this at hosting/deploy time once Lambda is set up (see
# README.md "Deploying to AWS").
RENDER_TARGET=local

# Where the AI-generated clips land, and where the app uploads new clips to.
# Reads and writes both go through short-lived presigned URLs - the bucket
# itself stays private. Leave unset to use the automatic local-disk fallback
# (public/uploads/) instead - genuinely optional until you have a bucket to
# paste in here; browsing/uploading will just use local disk until you do.
SOURCE_CLIPS_BUCKET=
SOURCE_CLIPS_REGION=
# Optional: only list objects under this prefix (leave unset to list the
# whole bucket).
SOURCE_CLIPS_PREFIX=

# Credentials for the IAM user created during Remotion Lambda setup (see
# README.md), reused for S3 browsing/uploading too.
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=

# Identify the deployed Remotion Lambda function and bundled site. Only
# needed once RENDER_TARGET=lambda.
REMOTION_REGION=
REMOTION_FUNCTION_NAME=
REMOTION_SERVE_URL=

# Enables free-form natural-language understanding (via Gemini) in the
# editor's prompt box - get a key from https://aistudio.google.com/apikey.
# Leave unset to use the built-in deterministic fallback instead (a fixed
# set of phrasings, see app/editor/parseCommand.ts) - genuinely optional
# until you're ready to paste one in here.
GEMINI_API_KEY=
